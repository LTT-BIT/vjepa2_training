{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen tomato independent evaluation catalog",
  "type": "object",
  "required": ["purpose", "collection_id", "used_for_training_or_selection", "records"],
  "properties": {
    "purpose": {"const": "independent_evaluation_only"},
    "collection_id": {"type": "string", "minLength": 1},
    "used_for_training_or_selection": {"const": false},
    "is_synthetic_test_fixture": {"type": "boolean", "default": false},
    "records": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataset_root", "episode_index", "source_recording_id", "annotation_path", "conditions"],
        "properties": {
          "dataset_root": {"type": "string", "minLength": 1},
          "annotation_path": {"type": "string", "minLength": 1},
          "episode_index": {"type": "integer", "minimum": 0},
          "source_recording_id": {"type": "string", "minLength": 1},
          "conditions": {"type": "object", "minProperties": 1}
        }
      }
    }
  },
  "description": "Runtime additionally checks frozen code/model/data hashes, source/content isolation, normal30Hz LeRobot dual-FR3/Sharpa schema, reviewed complete seven-stage labels and every video PTS/frame. Synthetic fixtures require an explicit smoke flag and never count as real independent evaluation."
}
